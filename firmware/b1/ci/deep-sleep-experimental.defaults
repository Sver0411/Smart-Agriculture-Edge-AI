CONFIG_B1_LAB_MODE=y
CONFIG_B1_USE_E220=y
# Illustrative PUBLIC readback only; commissioning must replace it and verify
# transparent mode / RSSI disabled / module variant. No claim of factory values.
CONFIG_B1_E220_EXPECTED_REGISTERS="0000620012000000"
CONFIG_B1_E220_FRAME_MTU=160

CONFIG_B1_DEEP_SLEEP_EXPERIMENTAL=y
CONFIG_B1_DEEP_MIN_SLEEP_MS=60000
CONFIG_B1_DEEP_COMM_WINDOW_MS=10000
CONFIG_B1_DEEP_MAX_CLOCK_ERROR_MS=100
