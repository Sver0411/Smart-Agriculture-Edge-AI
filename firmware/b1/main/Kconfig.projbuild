menu "Physical B1 configuration"
    config B1_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
    config B1_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
    config B1_A1_HOST
        string "Gateway A1 LAN host"
        default ""
    config B1_A1_PORT
        int "Gateway A1 port"
        default 9201
    config B1_A2_HOST
        string "Gateway A2 LAN host"
        default ""
    config B1_A2_PORT
        int "Gateway A2 port"
        default 9202
    config B1_SDA_GPIO
        int "SHT30 SDA GPIO"
        default 8
    config B1_SCL_GPIO
        int "SHT30 SCL GPIO"
        default 9
    config B1_LAB_MODE
        bool "Accelerated laboratory intervals"
        default y
    config B1_TEST_FAULT_INJECTION
        bool "Inject out-of-range temperature AFTER physical read (test only)"
        default n
endmenu
